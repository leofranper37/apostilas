rules_version = '2';
// Criador de Apostilas: cada cliente lê só a própria conta; só o administrador cadastra, libera, bloqueia e dá créditos.
// Créditos só diminuem pela Cloud Function "gerar" (que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    // Mesma lista de config.js (admins), no formato usuario@apostilas.local
    function admin() { return logado() && request.auth.token.email in ['admin@apostilas.local']; }

    match /clientes/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create, delete: if admin();
      allow update: if admin()
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apostilas', 'pdfs', 'ultimoAcesso'])
            && request.resource.data.get('apostilas', 0) >= resource.data.get('apostilas', 0)
            && request.resource.data.get('pdfs', 0) >= resource.data.get('pdfs', 0));
    }

    // Apostilas e imagens salvas na conta: só o dono lê e grava, e só enquanto o acesso estiver liberado
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function liberado(uid) { return admin() || get(/databases/$(database)/documents/clientes/$(uid)).data.ativo == true; }

    match /clientes/{uid}/apostilas/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && liberado(uid)
        && request.resource.data.keys().hasOnly(['titulo', 'salvoEm', 'dados'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
        && request.resource.data.salvoEm is number
        && request.resource.data.dados is string && request.resource.data.dados.size() < 900000;
    }

    match /clientes/{uid}/imagens/{h} {
      allow read: if dono(uid);
      allow create, update: if dono(uid) && liberado(uid)
        && request.resource.data.keys().hasOnly(['src'])
        && request.resource.data.src is string && request.resource.data.src.size() < 900000;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
