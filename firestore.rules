rules_version = '2';
// Criador de Apostilas: cada cliente lê só a própria conta; só o administrador cadastra, libera, bloqueia e dá créditos.
// Créditos só diminuem pela Cloud Function "gerar" (que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    // Mesma lista de config.js (admins), no formato usuario@apostilas.local
    function admin() { return logado() && request.auth.token.email in ['admin@apostilas.local']; }

    match /clientes/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create, delete: if admin();
      allow update: if admin()
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apostilas', 'pdfs', 'ultimoAcesso'])
            && request.resource.data.get('apostilas', 0) >= resource.data.get('apostilas', 0)
            && request.resource.data.get('pdfs', 0) >= resource.data.get('pdfs', 0));
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
